<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Beyond Age</title><style>[hidden]{display:none!important}*{box-sizing:border-box}body{margin:0;background:#f6f5f0;color:#233a44;font:16px/1.6 system-ui,sans-serif}main{max-width:1000px;margin:36px auto;padding:30px 38px;background:white;border:1px solid #dce2df;border-radius:8px}.eyebrow{font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#567568}h1{font:normal clamp(26px,4vw,36px)/1.2 Georgia,serif;margin:14px 0}h2{font:normal 25px Georgia,serif}p{max-width:78ch}.lead{color:#4d6169}.highlight{border-left:4px solid #bb795b;padding:10px 16px;background:#f8f1eb}label{display:inline-block;margin:8px 16px 12px 0}select,button{font:inherit;color:inherit;background:white;border:1px solid #a6b6b5;border-radius:4px;padding:6px 10px}button{cursor:pointer}button:hover,button:focus-visible{outline:2px solid #bb795b;outline-offset:2px}.axis{margin:12px 0 12px 180px;border-bottom:1px solid #d3dcda;padding-bottom:7px;color:#53676e;font-size:13px;display:flex;justify-content:space-between}.row{display:grid;grid-template-columns:165px 1fr;gap:15px;margin:16px 0;align-items:center}.name{font-size:14px}.name small{display:block;color:#61747a}.track{position:relative;display:block;width:100%;background:#f0f3f2;padding:0;height:30px;border:0;text-align:left;border-radius:0}.bar{display:block;height:100%;background:#2c6e73;min-width:1px}.track.unique .bar{background:#c58561}.value{position:absolute;right:8px;top:3px;font-size:13px;color:#20343e;background:#fffffff0;padding:0 4px;border-radius:2px}.pair .track{height:25px;margin:4px 0}.pair .value{top:0}.legend{font-size:14px}.dot{display:inline-block;width:12px;height:12px;background:#2c6e73;margin-right:5px}.dot.alt{background:#c58561}.details{min-height:70px;background:#f0f4f3;padding:12px 16px;border-radius:4px;font-size:14px}table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:right;padding:9px 7px;border-bottom:1px solid #dce2df}th:first-child,td:first-child{text-align:left}.tablewrap{overflow:auto}summary{cursor:pointer;margin:20px 0 6px}footer{font-size:13px;color:#586e74;border-top:1px solid #dce2df;margin-top:28px;padding-top:18px}a{color:#23666e}nav{display:flex;gap:16px;flex-wrap:wrap}iframe{width:100%;height:1000px;border:1px solid #ddd;background:white} @media(max-width:600px){main{margin:0;padding:22px 16px;border-radius:0}.row{grid-template-columns:110px 1fr;gap:8px}.axis{margin-left:118px}.name{font-size:12px}label{display:block}iframe{height:1150px}}</style></head><body><main><div class="eyebrow">Beyond Age · Research figure 1</div><h1></h1><p class="lead"></p><p class="highlight" id="note"></p><label>Display <select id="mode" aria-label="Display measure"></select></label><label>Sort <select id="sort" aria-label="Sort groups"><option value="shapley">Shapley contribution</option><option value="unique">Unique additional contribution</option><option value="alpha">Alphabetical</option></select></label><button id="download">Download data (CSV)</button><p id="legend" class="legend"></p><div id="axis" class="axis"></div><section id="chart" aria-label="Interactive bar chart"></section><p id="details" class="details" aria-live="polite"></p><details><summary>View numerical table</summary><div class="tablewrap"><table id="table"></table></div></details><footer>Source: supplied analysis of NIA’s 2025 Digital Divide Survey, general-population sample, ages 50–79; n = 2,884. Unweighted OLS with an intercept; ordinary in-sample R². Outcome: mean of 14 self-reported PC/mobile items (1–4). Results describe associations, not causal effects. No uncertainty intervals were estimated.<p><a href="index.html">All figures and article</a></p></footer></main><script>
const data={"models": [["M1", "Age", 0.338941825281], ["M2", "+ Education", 0.499364462844], ["M3", "+ Household income", 0.514877150448], ["M4", "+ Occupation", 0.532370600332], ["M5", "+ Gender and region", 0.54258887648]], "groups": [["Education", 21.43229, 39.500054, 8.116801], ["Age", 13.144483, 24.225492, 2.116766], ["Household income", 8.71593, 16.063599, 0.934993], ["Occupation", 7.988673, 14.723252, 1.426129], ["Gender", 1.845395, 3.401093, 0.603719], ["Region", 1.132117, 2.08651, 0.352]]},kind=0;
const titles=['Nested model explanatory power','Shapley contributions','Shapley versus unique additional contributions'];
const descriptions=['How much more variation is accounted for as groups are added? Models use the same 2,884 respondents.','An order-averaged allocation of the full model’s explanatory power across six predictor groups.','Two questions about the same model: average contribution across all orders, and additional contribution when entered last.'];
document.title=titles[kind]+' | Beyond Age';
document.querySelector('h1').textContent=titles[kind];document.querySelector('.lead').textContent=descriptions[kind];
const mode=document.querySelector('#mode'),sort=document.querySelector('#sort');
mode.innerHTML=(kind===0?['Cumulative R² (%)','Increase at each step (%p)']:kind===1?['Total variation (%p)','Explained variation (%)']:['Both measures (%p)','Shapley only (%p)','Unique additional only (%p)']).map((x,i)=>`<option value="${i}">${x}</option>`).join('');
if(kind===0){sort.parentElement.hidden=true;}
function rows(){let a=kind===0?data.models.map((r,i)=>({name:r[0],desc:r[1],v:r[2]*100,u:(r[2]-(i?data.models[i-1][2]:0))*100})):data.groups.map(r=>({name:r[0],desc:'',v:r[1],share:r[2],u:r[3]}));if(kind!==0&&sort.value==='alpha')a.sort((x,y)=>x.name.localeCompare(y.name));if(kind!==0&&sort.value==='unique')a.sort((x,y)=>y.u-x.u);return a;}
function render(){const m=Number(mode.value),a=rows(),max=kind===0?60:kind===1?(m===1?45:25):25;
document.querySelector('#axis').innerHTML=`<span>0</span><span>${max/2}</span><span>${max} ${kind===0&&m===0||kind===1&&m===1?'%':'%p'}</span>`;
document.querySelector('#legend').innerHTML=kind===2?'<span class="dot"></span>Shapley &nbsp; <span class="dot alt"></span>Unique additional':'';
let html='';for(const r of a){let series=kind===2?(m===1?[[r.v,'Shapley','']]:m===2?[[r.u,'Unique additional','unique']]:[[r.v,'Shapley',''],[r.u,'Unique additional','unique']]):[[kind===0?(m===0?r.v:r.u):(m===0?r.v:r.share),kind===0?(m===0?'Cumulative R²':'Step increase'):'Shapley','']];
html+=`<div class="row"><div class="name">${r.name}<small>${r.desc}</small></div><div class="${kind===2?'pair':''}">`;
for(const [v,label,cls]of series){let unit=kind===0&&m===0||kind===1&&m===1?'%':' percentage points';let msg=`${r.name}: ${label} = ${v.toFixed(4)}${unit}. `+(kind===0?(m===0?'Cumulative model fit.':'Order-specific increment; M1 is relative to the intercept-only model.'):kind===1?(m===0?'Denominator: total observed score variation.':'Denominator: variation explained by the full model (R² = 0.542588876480).'):(cls==='unique'?'Added after all five other groups.':'Averaged over all 720 group orderings.'));
html+=`<button class="track ${cls}" data-detail="${msg}" aria-label="${msg}"><span class="bar" style="width:${v/max*100}%"></span><span class="value">${v.toFixed(2)}</span></button>`;}html+='</div></div>';}
document.querySelector('#chart').innerHTML=html;
document.querySelectorAll('[data-detail]').forEach(b=>['mouseenter','focus','click'].forEach(e=>b.addEventListener(e,()=>document.querySelector('#details').textContent=b.dataset.detail)));
document.querySelector('#details').textContent='Hover, tap, or keyboard-focus a bar to see its exact value and interpretation.';
const head=kind===0?['Model','R²','Step increase (%p)']:['Group','Shapley (%p)','Share explained (%)','Unique additional (%p)'];
document.querySelector('#table').innerHTML='<thead><tr>'+head.map(x=>`<th scope="col">${x}</th>`).join('')+'</tr></thead><tbody>'+a.map(r=>'<tr><th scope="row">'+r.name+'</th>'+(kind===0?[r.v/100,r.u]:[r.v,r.share,r.u]).map(x=>`<td>${x.toFixed(kind===0?8:6)}</td>`).join('')+'</tr>').join('')+'</tbody>';
document.querySelector('#note').textContent=kind===0?'The cumulative model increases from 33.89% to 54.26%: +20.36 percentage points beyond age. Entry order affects the step increments.':kind===1?'Education receives 21.43 percentage points of total variation, equivalent to 39.50% of explained variation. Neither figure is a causal effect.':'Unique increments need not sum to full-model R². The gap between measures is not a mediation effect.';
}
mode.addEventListener('change',render);sort.addEventListener('change',render);
document.querySelector('#download').addEventListener('click',()=>{const a=kind===0?[['Model','Added group','R2','Step increase pp'],...data.models.map((r,i)=>[...r,(r[2]-(i?data.models[i-1][2]:0))*100])]:[['Group','Shapley pp','Share of explained percent','Unique additional pp'],...data.groups];const blob=new Blob(['\ufeff'+a.map(r=>r.join(',')).join('\n')],{type:'text/csv;charset=utf-8'}),url=URL.createObjectURL(blob),el=document.createElement('a');el.href=url;el.download=kind===0?'nested-models.csv':'contributions.csv';el.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});render();
</script></body></html>
